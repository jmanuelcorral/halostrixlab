# Base AMD PyTorch ROCm 7.14 validada localmente; mantener el digest.
BASE_IMAGE=rocm/pytorch@sha256:c38eeda81d85f00fbe35d3d50ce42ce59c524e87d810624f4eb5c52fddb3b9ad

# Release upstream v0.9.5, resuelta a este commit el 2026-08-31.
LLAMAFACTORY_COMMIT=7af909522a951e3ad9f022ea6f88b6755257eaa5
LLAMAFACTORY_IMAGE=halostrix-llamafactory:v0.9.5-rocm7.14
# Opcional: ID sha256 de una imagen ya construida; start.sh nunca reconstruye.
RUN_IMAGE=
PIP_INDEX_URL=https://pypi.org/simple

# Nodo GPU mínimo. Cámbialo si readlink -f /dev/dri/by-path/*-render apunta a otro.
RENDER_DEVICE=/dev/dri/renderD128

# Grupo suplementario del render node; start.sh lo detecta si queda vacío.
DEVICE_GID=

# Seguro por defecto: sólo el propio host. Para LAN, usar 0.0.0.0 y limitar firewall.
WEB_BIND=127.0.0.1
WEB_PORT=7860
SHM_SIZE=16g
