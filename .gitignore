# These installed workflows depend on private, local Squad state.
# Keep unrelated or future CI workflows publishable.
/.github/workflows/squad-heartbeat.yml
/.github/workflows/squad-issue-assign.yml
/.github/workflows/squad-triage.yml
/.github/workflows/sync-squad-labels.yml

# Private environment files; publish only reviewed example templates.
.env
.env.*
*.env
*.env.*
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template
*.local

