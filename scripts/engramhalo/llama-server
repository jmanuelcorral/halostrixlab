#!/usr/bin/env python3
"""EngramHalo Docker wrapper, invoked by Lemonade's rocm_bin as ``llama-server``.

EXPERIMENTAL, NOT DEPLOYED. See scripts/engramhalo/README.md for the full
contract, threat model, and manual deployment steps. This file implements a
fail-closed argv translator + narrowly scoped ``docker run`` launcher. It
never builds or pulls images, never contacts a network model registry, and
never reads real host ``.env`` files.

Standard library only. No third-party imports.
"""

from __future__ import annotations

import errno
import fcntl
import json
import os
import re
import signal
import socket
import stat
import subprocess
import sys
import time
import uuid

PROG = "engramhalo-llama-server"

# --- fixed, non-negotiable engine invocation flags ------------------------

_SHA256_HEX = re.compile(r"^[0-9a-fA-F]{64}$")
_ID_LIKE = re.compile(r"^[a-z0-9]+([._-][a-z0-9]+)*$")
_RENDER_DEV_RE = re.compile(r"^/dev/dri/renderD[0-9]+$")

_DANGEROUS_FLAGS = {
    "-hf", "--hf-repo", "-hfd", "--hf-repo-draft", "--hf-file", "--hf-token",
    "--model-url", "-mu", "--api-key", "--api-key-file", "--lora",
    "--lora-base", "--lora-scaled", "--draft", "--draft-model", "--mtp",
    "--mtp-model", "--prompt-file", "-f", "--prompt-cache",
    "--prompt-cache-all", "--upload", "--chat-template-file", "--log-file",
    "--path", "--embedding", "--rpc", "--no-mmap",
}

# Boolean (no-value) flags accepted verbatim.
_BOOL_FLAGS = {"--jinja", "--metrics", "--mmap", "--no-kv-unified", "--cpu-moe"}

_FLASH_ATTN_MODES = {"on", "off", "auto"}
_LOAD_MODES = {"mmap"}
_CACHE_TYPES = {"f16", "q8_0"}
_SPEC_TYPES = {"none"}
_OVERRIDE_TENSOR_EXACT = "^per_layer_token_embd[.]weight$=CPU"

# Value flags accepted, mapped to a canonical key and a validator name.
_VALUE_FLAGS = {
    "-m": ("model", "model"),
    "--model": ("model", "model"),
    "--mmproj": ("mmproj", "mmproj"),
    "--port": ("port", "port"),
    "--ctx-size": ("ctx_size", "posint"),
    "--parallel": ("parallel", "parallel"),
    "--host": ("host", "host"),
    "-t": ("threads", "posint"),
    "--threads": ("threads", "posint"),
    "--threads-batch": ("threads_batch", "posint"),
    "-b": ("batch_size", "posint"),
    "--batch-size": ("batch_size", "posint"),
    "--ubatch-size": ("ubatch_size", "posint"),
    "-ngl": ("n_gpu_layers", "nonnegint"),
    "--n-gpu-layers": ("n_gpu_layers", "nonnegint"),
    "--flash-attn": ("flash_attn", "flash_attn"),
    "--load-mode": ("load_mode", "load_mode"),
    "-lm": ("load_mode", "load_mode"),
    "--cache-type-k": ("cache_type_k", "cache_type"),
    "--cache-type-v": ("cache_type_v", "cache_type"),
    "--spec-type": ("spec_type", "spec_type"),
    "--n-cpu-moe": ("n_cpu_moe", "nonnegint"),
    "--override-tensor": ("override_tensor", "override_tensor"),
}

_REQUIRED_KEYS = {"model", "port", "ctx_size", "parallel"}

_FORBIDDEN_ROOT_NAMES = {"/", "/root", "/home", "/etc", "/boot", "/sys", "/proc"}

# Startup lifecycle bound (seconds) for waiting on the engine subprocess CID.
_CID_WAIT_SECONDS = 5.0
_STOP_CID_WAIT_SECONDS = 5.0


class WrapperError(Exception):
    """Fail-closed error raised before any docker/engine invocation."""


def _fail(msg: str) -> "None":
    raise WrapperError(msg)


# --- config -----------------------------------------------------------------

def load_config() -> dict:
    path = os.environ.get("ENGRAMHALO_CONFIG")
    if not path:
        _fail("ENGRAMHALO_CONFIG is not set; refusing to guess a config path")
    if not os.path.isabs(path):
        _fail("ENGRAMHALO_CONFIG must be an absolute path")
    if os.path.islink(path):
        _fail("ENGRAMHALO_CONFIG must not be a symlink")
    try:
        cfg_st = os.stat(path)
    except OSError as exc:
        _fail(f"cannot stat ENGRAMHALO_CONFIG: {exc.strerror}")
    else:
        if not stat.S_ISREG(cfg_st.st_mode):
            _fail("ENGRAMHALO_CONFIG must be a regular file")
        if cfg_st.st_uid not in (0, os.getuid()):
            _fail("ENGRAMHALO_CONFIG must be owned by root or the current user")
        if cfg_st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            _fail("ENGRAMHALO_CONFIG must not be group- or world-writable")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = fh.read()
    except OSError as exc:
        _fail(f"cannot read ENGRAMHALO_CONFIG: {exc.strerror}")
    try:
        cfg = json.loads(raw)
    except json.JSONDecodeError as exc:
        _fail(f"ENGRAMHALO_CONFIG is not valid JSON: {exc}")
    if not isinstance(cfg, dict):
        _fail("ENGRAMHALO_CONFIG must contain a JSON object")
    return validate_config(cfg)


def _abs_clean(p, field) -> str:
    if not isinstance(p, str) or not p:
        _fail(f"config field {field!r} must be a non-empty string")
    if not os.path.isabs(p):
        _fail(f"config field {field!r} must be an absolute path")
    if "\n" in p or "," in p or ":" in p:
        _fail(f"config field {field!r} contains forbidden characters")
    return os.path.normpath(p)


def _validate_trusted_executable(path: str, field: str) -> str:
    """Resolve symlinks (legitimate distro /usr/bin aliases) and require the
    final target to be a root- or current-user-owned, non group/world
    writable regular executable file."""
    real = os.path.realpath(path)
    try:
        st = os.stat(real)
    except OSError as exc:
        _fail(f"{field} does not resolve to an accessible file: {exc.strerror}")
    if not stat.S_ISREG(st.st_mode):
        _fail(f"{field} must resolve to a regular file")
    if not (st.st_mode & stat.S_IXUSR):
        _fail(f"{field} must be executable by its owner")
    if st.st_uid not in (0, os.getuid()):
        _fail(f"{field} must be owned by root or the current user; refusing")
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        _fail(f"{field} must not be group- or world-writable")
    return path


def _gpu_canonical_ok(real: str, kind: str) -> bool:
    """Pure canonical-path check, isolated so offline unit tests can patch
    this single function to point at test device stand-ins (e.g. /dev/null,
    /dev/zero) instead of relaxing anything in the production code path.
    There is no environment variable or runtime flag that bypasses this
    check; the real wrapper always requires the canonical device path.
    """
    if kind == "kfd":
        return real == "/dev/kfd"
    return bool(_RENDER_DEV_RE.match(real))


def _validate_gpu_device(path: str, kind: str) -> str:
    """Restrict GPU device configuration to the canonical device nodes only.

    kind == 'kfd'    -> must resolve to exactly /dev/kfd
    kind == 'render' -> must resolve to /dev/dri/renderD<digits>
    """
    real = os.path.realpath(path)
    if not _gpu_canonical_ok(real, kind):
        _fail(
            f"gpu device {path!r} is not the canonical {kind} device path "
            "(expected /dev/kfd or /dev/dri/renderD<N>)"
        )
    try:
        dst = os.stat(real)
    except OSError as exc:
        _fail(f"gpu device {path!r} is not accessible: {exc.strerror}")
    if stat.S_ISBLK(dst.st_mode):
        _fail(f"gpu device {path!r} must not be a block device")
    if not stat.S_ISCHR(dst.st_mode):
        _fail(f"gpu device {path!r} must be a character device")
    return path


def validate_config(cfg: dict) -> dict:
    image = cfg.get("image")
    if not isinstance(image, str) or not image:
        _fail("config field 'image' is required")
    if "@sha256:" in image:
        repo, _, digest = image.partition("@sha256:")
        if not repo or not _SHA256_HEX.match(digest):
            _fail("config field 'image' has an invalid digest reference")
    elif image.startswith("sha256:"):
        if not _SHA256_HEX.match(image[len("sha256:"):]):
            _fail("config field 'image' has an invalid sha256 image id")
    else:
        _fail(
            "config field 'image' must be pinned by '<repo>@sha256:<64 hex>' "
            "or a bare 'sha256:<64 hex>' image id; tags/latest are rejected"
        )

    engine = _abs_clean(cfg.get("engine"), "engine")
    if not os.path.isfile(engine) or not os.access(engine, os.X_OK):
        _fail("config field 'engine' must be an existing executable file")
    _validate_trusted_executable(engine, "engine")

    engine_server = _abs_clean(cfg.get("engine_server"), "engine_server")

    roots_raw = cfg.get("allowed_model_roots")
    if not isinstance(roots_raw, list) or not roots_raw:
        _fail("config field 'allowed_model_roots' must be a non-empty list")
    roots = []
    home = os.path.expanduser("~")
    for r in roots_raw:
        rr = _abs_clean(r, "allowed_model_roots[]")
        if rr in _FORBIDDEN_ROOT_NAMES or rr == home:
            _fail(f"allowed_model_roots entry {rr!r} is too broad; refusing")
        if ".ssh" in rr.split(os.sep) or ".config" in rr.split(os.sep):
            _fail(f"allowed_model_roots entry {rr!r} targets a sensitive directory")
        roots.append(rr)
    roots_real = [os.path.realpath(r) for r in roots]

    state_dir = _abs_clean(cfg.get("runtime_state_dir"), "runtime_state_dir")
    try:
        st = os.lstat(state_dir)
    except OSError as exc:
        _fail(f"runtime_state_dir does not exist or is not accessible: {exc.strerror}")
    if stat.S_ISLNK(st.st_mode):
        _fail("runtime_state_dir must not be a symlink")
    if not stat.S_ISDIR(st.st_mode):
        _fail("runtime_state_dir must be a directory")
    if st.st_uid != os.getuid():
        _fail("runtime_state_dir must be owned by the current user")
    if (st.st_mode & 0o777) != 0o700:
        _fail("runtime_state_dir must have mode 0700")

    render_dev = _abs_clean(cfg.get("gpu_render_device"), "gpu_render_device")
    kfd_dev = _abs_clean(cfg.get("gpu_kfd_device"), "gpu_kfd_device")
    _validate_gpu_device(render_dev, "render")
    _validate_gpu_device(kfd_dev, "kfd")

    uid = cfg.get("uid")
    gid = cfg.get("gid")
    if not isinstance(uid, int) or isinstance(uid, bool) or uid <= 0:
        _fail("config field 'uid' must be a positive integer (non-root)")
    if not isinstance(gid, int) or isinstance(gid, bool) or gid <= 0:
        _fail("config field 'gid' must be a positive integer (non-root)")
    if uid != os.getuid():
        _fail(
            "config field 'uid' must match the invoking process uid; "
            "arbitrary uid impersonation is refused"
        )
    if gid != os.getgid() and gid not in os.getgroups():
        _fail(
            "config field 'gid' must match the invoking process gid or one "
            "of its supplementary groups; arbitrary gid impersonation is refused"
        )

    allowed_models_raw = cfg.get("allowed_models")
    if not isinstance(allowed_models_raw, list) or not allowed_models_raw:
        _fail("config field 'allowed_models' must be a non-empty list")
    allowed_models = []
    for entry in allowed_models_raw:
        if not isinstance(entry, dict):
            _fail("each 'allowed_models' entry must be an object")
        model_path = _abs_clean(entry.get("model"), "allowed_models[].model")
        model_real = _resolve_within_roots(model_path, roots, "allowed_models[].model")
        if os.path.dirname(model_real) not in roots_real:
            _fail(
                "allowed_models[].model must live directly inside one of "
                "allowed_model_roots (a dedicated, operator-approved "
                "directory), not a deeper nested subdirectory"
            )
        mmproj_path = entry.get("mmproj")
        mmproj_real = None
        if mmproj_path is not None:
            mmproj_path = _abs_clean(mmproj_path, "allowed_models[].mmproj")
            mmproj_real = _resolve_within_roots(mmproj_path, roots, "allowed_models[].mmproj")
            if os.path.dirname(mmproj_real) not in roots_real:
                _fail(
                    "allowed_models[].mmproj must live directly inside one "
                    "of allowed_model_roots (dedicated directory)"
                )
        allowed_models.append({"model": model_real, "mmproj": mmproj_real})

    return {
        "image": image,
        "engine": engine,
        "engine_server": engine_server,
        "allowed_model_roots": roots,
        "runtime_state_dir": state_dir,
        "gpu_render_device": render_dev,
        "gpu_kfd_device": kfd_dev,
        "uid": uid,
        "gid": gid,
        "allowed_models": allowed_models,
    }


def _resolve_within_roots(path: str, roots: list, field: str) -> str:
    real = os.path.realpath(path)
    for root in roots:
        root_real = os.path.realpath(root)
        if real == root_real or real.startswith(root_real + os.sep):
            return real
    _fail(f"{field} value {path!r} escapes allowed_model_roots (symlink or path traversal)")
    return real  # unreachable, keeps type checkers calm


# --- argv parsing -------------------------------------------------------

def _split_flag(tok: str):
    if "=" in tok and tok.startswith("-"):
        k, _, v = tok.partition("=")
        return k, v
    return tok, None


def parse_forward_args(argv: list) -> dict:
    """Whitelist parse of the flags Lemonade forwards. Fail-closed."""
    parsed = {}
    bool_seen = set()
    i = 0
    while i < len(argv):
        tok = argv[i]
        key, inline_val = _split_flag(tok)
        if key in _DANGEROUS_FLAGS:
            _fail(f"flag {key!r} is explicitly denied in EngramHalo v1")
        if key in _BOOL_FLAGS:
            if key in bool_seen:
                _fail(f"duplicate flag {key!r}")
            bool_seen.add(key)
            if inline_val is not None:
                _fail(f"flag {key!r} does not take a value")
            parsed[key.lstrip("-").replace("-", "_")] = True
            i += 1
            continue
        if key in _VALUE_FLAGS:
            canon, kind = _VALUE_FLAGS[key]
            if canon in parsed:
                _fail(f"duplicate flag for {canon!r} ({key!r})")
            if inline_val is not None:
                value = inline_val
                i += 1
            else:
                if i + 1 >= len(argv):
                    _fail(f"flag {key!r} requires a value")
                value = argv[i + 1]
                i += 2
            parsed[canon] = _typed(canon, kind, value)
            continue
        _fail(f"unknown or unauthorized flag {tok!r}; EngramHalo v1 uses a fixed allowlist")
    missing = _REQUIRED_KEYS - set(parsed)
    if missing:
        _fail(f"missing required flag(s): {', '.join(sorted(missing))}")
    if parsed["parallel"] != 1:
        _fail("--parallel must be 1 in EngramHalo v1 (no N>=2 yet)")
    host = parsed.get("host")
    if host is None:
        parsed["host"] = "127.0.0.1"
    elif host != "127.0.0.1":
        _fail("--host must be 127.0.0.1 in EngramHalo v1 (host networking is enforced)")
    if "cpu_moe" in parsed and "n_cpu_moe" in parsed:
        _fail("--cpu-moe and --n-cpu-moe are mutually exclusive")
    return parsed


def _typed(canon, kind, value):
    if kind == "port":
        try:
            v = int(value)
        except ValueError:
            _fail("--port must be an integer")
        if not (1 <= v <= 65535):
            _fail("--port must be in 1..65535")
        return v
    if kind == "posint":
        try:
            v = int(value)
        except ValueError:
            _fail(f"{canon} must be an integer")
        if v <= 0:
            _fail(f"{canon} must be positive")
        return v
    if kind == "nonnegint":
        try:
            v = int(value)
        except ValueError:
            _fail(f"{canon} must be an integer")
        if v < 0:
            _fail(f"{canon} must be non-negative")
        return v
    if kind == "parallel":
        try:
            v = int(value)
        except ValueError:
            _fail("--parallel must be an integer")
        return v
    if kind == "host":
        return value
    if kind == "model":
        if not os.path.isabs(value):
            _fail(f"{canon} path must be absolute")
        return value
    if kind == "mmproj":
        if not os.path.isabs(value):
            _fail("--mmproj path must be absolute")
        return value
    if kind == "flash_attn":
        if value not in _FLASH_ATTN_MODES:
            _fail("--flash-attn must be one of: on, off, auto")
        return value
    if kind == "load_mode":
        if value not in _LOAD_MODES:
            _fail("--load-mode (or -lm) only supports 'mmap' in EngramHalo v1")
        return value
    if kind == "cache_type":
        if value not in _CACHE_TYPES:
            _fail(f"{canon} must be one of: f16, q8_0")
        return value
    if kind == "spec_type":
        if value not in _SPEC_TYPES:
            _fail("--spec-type only supports 'none' in EngramHalo v1")
        return value
    if kind == "override_tensor":
        if value != _OVERRIDE_TENSOR_EXACT:
            _fail(
                "--override-tensor only supports the exact known profile "
                f"value {_OVERRIDE_TENSOR_EXACT!r}"
            )
        return value
    _fail(f"internal: unhandled kind {kind!r}")


def resolve_model(cfg: dict, parsed: dict) -> dict:
    model_real = os.path.realpath(parsed["model"])
    match = None
    for entry in cfg["allowed_models"]:
        if entry["model"] == model_real:
            match = entry
            break
    if match is None:
        _fail("--model is not an exact entry of config 'allowed_models'; refusing arbitrary -m")
    mmproj = parsed.get("mmproj")
    if mmproj is not None:
        mmproj_real = os.path.realpath(mmproj)
        if match["mmproj"] != mmproj_real:
            _fail("--mmproj does not match the approved mmproj for the selected model")
    return match


# --- lifecycle helpers -------------------------------------------------------

def check_port_free(host: str, port: int) -> None:
    """Best-effort loopback probe. Not race-free; the flock lock is primary."""
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        s.bind((host, port))
    except OSError:
        _fail(f"port {port} on {host} appears to be already bound")
    finally:
        s.close()


def _ensure_private_dir(path: str) -> None:
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode):
        _fail(f"{path} must not be a symlink")
    if not stat.S_ISDIR(st.st_mode):
        _fail(f"{path} must be a directory")
    if st.st_uid != os.getuid():
        _fail(f"{path} must be owned by the current user")
    if (st.st_mode & 0o777) != 0o700:
        _fail(f"{path} must have mode 0700")


def acquire_lock(state_dir: str, name: str):
    """Acquire a private, non-blocking flock under state_dir/locks/<name>.lock."""
    locks_dir = os.path.join(state_dir, "locks")
    os.makedirs(locks_dir, mode=0o700, exist_ok=True)
    _ensure_private_dir(locks_dir)
    lock_path = os.path.join(locks_dir, f"{name}.lock")
    if os.path.islink(lock_path):
        _fail(f"{name} lock path is a symlink; refusing")
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        os.close(fd)
        _fail(f"{name} lock path is not a regular file")
    if st.st_nlink != 1:
        os.close(fd)
        _fail(f"{name} lock path has unexpected hard links; refusing")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        os.close(fd)
        if exc.errno in (errno.EACCES, errno.EAGAIN):
            _fail(f"another EngramHalo wrapper instance holds the {name!r} lock")
        raise
    return fd


def acquire_port_lock(state_dir: str, port: int):
    return acquire_lock(state_dir, f"port-{port}")


def acquire_global_lock(state_dir: str):
    return acquire_lock(state_dir, "global")


def _release_lock(fd) -> None:
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


# --- durable active-run marker ------------------------------------------

def _active_marker_path(state_dir: str) -> str:
    return os.path.join(state_dir, "active.json")


def write_active_marker(state_dir: str, data: dict) -> str:
    path = _active_marker_path(state_dir)
    if os.path.lexists(path):
        _fail(
            "active.json already exists from a previous EngramHalo run; "
            "refusing to start. Inspect the recorded run_uuid/name/cidfile "
            "in that file, confirm the container's real state by hand with "
            "the configured engine, and remove active.json only after "
            "manual verification. No automatic cleanup by port or label."
        )
    tmp = f"{path}.tmp-{os.getpid()}-{uuid.uuid4().hex}"
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise
    return path


def remove_active_marker(state_dir: str) -> None:
    path = _active_marker_path(state_dir)
    try:
        os.remove(path)
    except OSError:
        pass


def new_cidfile(state_dir: str) -> str:
    cids_dir = os.path.join(state_dir, "cids")
    os.makedirs(cids_dir, mode=0o700, exist_ok=True)
    path = os.path.join(cids_dir, f"{uuid.uuid4().hex}.cid")
    if os.path.lexists(path):
        _fail("cidfile path already exists; refusing to overwrite")
    return path


def read_cid_safe(cidfile: str, timeout: float = 5.0):
    """Read the cid written by the engine's own docker client, defensively:
    no symlink following, must be a private regular file with a single hard
    link owned by the current user."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            fd = os.open(cidfile, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            time.sleep(0.05)
            continue
        try:
            st = os.fstat(fd)
            if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1
                    or st.st_uid != os.getuid()):
                os.close(fd)
                return None
            with os.fdopen(fd, "r", encoding="utf-8") as fh:
                data = fh.read().strip()
        except OSError:
            data = ""
        if data:
            return data
        time.sleep(0.05)
    return None


def inspect_owned_detailed(engine: str, cid: str, name: str, run_label: str):
    """Return (identity_ok, running, err_kind) for the container 'cid'.

    err_kind is one of: None (inspect succeeded), 'not_found', 'daemon_error'.
    """
    try:
        out = subprocess.run(
            [engine, "inspect", "--format",
             '{{.State.Running}}|{{.Name}}|{{index .Config.Labels "engramhalo.run"}}',
             cid],
            capture_output=True, text=True, timeout=10, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False, False, "daemon_error"
    if out.returncode != 0:
        err = (out.stderr or "").lower()
        if "no such object" in err or "no such container" in err:
            return True, False, "not_found"
        return False, False, "daemon_error"
    line = out.stdout.strip()
    parts = line.split("|", 2)
    if len(parts) != 3:
        return False, False, "daemon_error"
    running_s, got_name, got_label = parts
    identity_ok = (got_name.lstrip("/") == name and got_label == run_label)
    running = running_s.strip().lower() == "true"
    return identity_ok, running, None


def stop_owned_container(engine: str, cid: str, name: str, run_label: str) -> None:
    """Best-effort stop used from the (flag-only) signal path; the
    authoritative post-exit verification happens in _final_cleanup."""
    if not cid:
        return
    ok, running, err = inspect_owned_detailed(engine, cid, name, run_label)
    if err == "not_found":
        return
    if err == "daemon_error" or not ok:
        sys.stderr.write(
            f"{PROG}: cannot verify ownership of cid {cid} before stopping; "
            "not touching it\n"
        )
        return
    if running:
        subprocess.run([engine, "stop", "-t", "10", cid], timeout=15, check=False)


def _final_cleanup(engine: str, cid: str, name: str, run_label: str):
    """Authoritative post-exit cleanup. Returns (identity_ok, presence) where
    presence is one of: 'absent', 'running', 'unknown'."""
    ok, running, err = inspect_owned_detailed(engine, cid, name, run_label)
    if err == "not_found":
        return True, "absent"
    if err == "daemon_error":
        return True, "unknown"
    if not ok:
        return False, "unknown"
    if running:
        subprocess.run([engine, "stop", "-t", "10", cid], timeout=15, check=False)
    ok2, running2, err2 = inspect_owned_detailed(engine, cid, name, run_label)
    if err2 == "not_found":
        return True, "absent"
    if err2 == "daemon_error":
        return True, "unknown"
    if not ok2:
        return False, "unknown"
    if not running2:
        return True, "absent"
    subprocess.run([engine, "rm", "-f", cid], timeout=15, check=False)
    ok3, running3, err3 = inspect_owned_detailed(engine, cid, name, run_label)
    if err3 == "not_found":
        return True, "absent"
    if err3 == "daemon_error":
        return True, "unknown"
    if not ok3:
        return False, "unknown"
    return True, ("running" if running3 else "absent")


# --- docker argv construction ------------------------------------------------

def build_run_argv(cfg: dict, parsed: dict, model_entry: dict, cidfile: str,
                    name: str, run_label: str) -> list:
    mounts = []
    seen_roots = set()
    mount_paths = [model_entry["model"]]
    if parsed.get("mmproj") is not None:
        # Only mount/forward mmproj if the caller actually requested one;
        # never auto-add a configured mmproj the request never asked for.
        mount_paths.append(model_entry["mmproj"])
    for p in mount_paths:
        if p is None:
            continue
        d = os.path.dirname(p)
        if d not in seen_roots:
            seen_roots.add(d)
            mounts.append(("--mount", f"type=bind,src={d},dst={d},readonly"))

    render_gid = os.stat(cfg["gpu_render_device"]).st_gid
    kfd_gid = os.stat(cfg["gpu_kfd_device"]).st_gid

    argv = [cfg["engine"], "run", "--rm", "--init", "--sig-proxy=true",
            "--pull=never", "--network=host",
            "--user", f"{cfg['uid']}:{cfg['gid']}",
            "--group-add", str(render_gid),
            "--group-add", str(kfd_gid),
            "--cap-drop=ALL", "--security-opt=no-new-privileges",
            "--device", f"{cfg['gpu_render_device']}:{cfg['gpu_render_device']}",
            "--device", f"{cfg['gpu_kfd_device']}:{cfg['gpu_kfd_device']}"]
    for flag, val in mounts:
        argv += [flag, val]
    argv += ["--cidfile", cidfile, "--name", name,
             "--label", f"engramhalo.run={run_label}",
             "--entrypoint", cfg["engine_server"], cfg["image"]]

    server_args = ["--model", model_entry["model"]]
    if parsed.get("mmproj") is not None:
        server_args += ["--mmproj", model_entry["mmproj"]]
    server_args += ["--port", str(parsed["port"])]
    server_args += ["--ctx-size", str(parsed["ctx_size"])]
    server_args += ["--parallel", "1"]
    server_args += ["--host", parsed["host"]]
    for key in ("threads", "threads_batch", "batch_size", "ubatch_size",
                "n_gpu_layers", "n_cpu_moe"):
        if key in parsed:
            server_args += ["--" + key.replace("_", "-"), str(parsed[key])]
    if parsed.get("jinja"):
        server_args.append("--jinja")
    if parsed.get("metrics"):
        server_args.append("--metrics")
    if "flash_attn" in parsed:
        server_args += ["--flash-attn", parsed["flash_attn"]]
    # mmap is the only supported load mode in EngramHalo v1; make it
    # explicit on every launch regardless of which alias the caller used
    # (--mmap and/or --load-mode mmap), so the effective engine default is
    # never left implicit.
    server_args.append("--mmap")
    if "cache_type_k" in parsed:
        server_args += ["--cache-type-k", parsed["cache_type_k"]]
    if "cache_type_v" in parsed:
        server_args += ["--cache-type-v", parsed["cache_type_v"]]
    if "spec_type" in parsed:
        server_args += ["--spec-type", parsed["spec_type"]]
    if parsed.get("no_kv_unified"):
        server_args.append("--no-kv-unified")
    if parsed.get("cpu_moe"):
        server_args.append("--cpu-moe")
    if "override_tensor" in parsed:
        server_args += ["--override-tensor", parsed["override_tensor"]]

    return argv + server_args


def run_fastpath(cfg: dict, sole_flag: str) -> int:
    argv = [cfg["engine"], "run", "--rm", "--pull=never",
            "--entrypoint", cfg["engine_server"], cfg["image"], sole_flag]
    proc = subprocess.Popen(argv)
    return proc.wait()


def _run_engine(cfg: dict, parsed: dict, model_entry: dict) -> int:
    state_dir = cfg["runtime_state_dir"]
    cidfile = new_cidfile(state_dir)
    name = "engramhalo-" + uuid.uuid4().hex[:12]
    run_label = str(uuid.uuid4())

    marker = {
        "run_uuid": run_label,
        "name": name,
        "cidfile": cidfile,
        "engine": cfg["engine"],
        "image": cfg["image"],
        "port": parsed["port"],
        "pid": os.getpid(),
        "started_at": time.time(),
    }
    write_active_marker(state_dir, marker)

    run_argv = build_run_argv(cfg, parsed, model_entry, cidfile, name, run_label)

    stop_state = {"requested": False, "sig": None}

    def _handler(signum, _frame):
        # Signal-safe: only sets flags, no blocking or subprocess calls here.
        stop_state["requested"] = True
        stop_state["sig"] = signum

    old_term = signal.signal(signal.SIGTERM, _handler)
    old_int = signal.signal(signal.SIGINT, _handler)

    cid = None
    stop_attempted = False
    rc = None
    proc = None
    try:
        proc = subprocess.Popen(run_argv)
        while True:
            try:
                rc = proc.wait(timeout=0.2)
                break
            except subprocess.TimeoutExpired:
                pass
            if stop_state["requested"] and not stop_attempted:
                stop_attempted = True
                if cid is None:
                    cid = read_cid_safe(cidfile, timeout=_STOP_CID_WAIT_SECONDS)
                if cid:
                    stop_owned_container(cfg["engine"], cid, name, run_label)
                else:
                    sys.stderr.write(
                        f"{PROG}: signal received before a cid was observed; "
                        "cannot verify or stop anything yet, waiting for the "
                        "child to exit\n"
                    )
        if cid is None:
            cid = read_cid_safe(cidfile, timeout=0.5)
    finally:
        signal.signal(signal.SIGTERM, old_term)
        signal.signal(signal.SIGINT, old_int)

    if cid is None:
        sys.stderr.write(
            f"{PROG}: engine client exited (rc={rc}) without ever writing a "
            "cid; the container lifecycle is unresolved so this is treated "
            "as a startup failure, not success\n"
        )
        return rc if rc not in (None, 0) else 9

    identity_ok, presence = _final_cleanup(cfg["engine"], cid, name, run_label)
    if not identity_ok:
        sys.stderr.write(
            f"{PROG}: cid {cid} name/label no longer matches this run; "
            "refusing to stop/remove it, retaining active.json for manual "
            "recovery\n"
        )
        return rc if rc not in (None, 0) else 9
    if presence != "absent":
        sys.stderr.write(
            f"{PROG}: could not confirm container {cid} is absent after "
            f"cleanup (state={presence!r}); retaining active.json for "
            "manual recovery\n"
        )
        return rc if rc not in (None, 0) else 9

    remove_active_marker(state_dir)
    try:
        if os.path.isfile(cidfile):
            os.remove(cidfile)
    except OSError:
        pass

    if stop_state["requested"]:
        return 128 + stop_state["sig"]
    return rc


def main(argv: list) -> int:
    fastpath = len(argv) == 1 and argv[0] in ("--help", "--version")

    try:
        cfg = load_config()
    except WrapperError as exc:
        sys.stderr.write(f"{PROG}: refusing to start: {exc}\n")
        return 2

    global_lock_fd = None
    try:
        # Global singleton lock acquired before ANY engine invocation,
        # including the --help/--version fastpath.
        global_lock_fd = acquire_global_lock(cfg["runtime_state_dir"])

        if fastpath:
            return run_fastpath(cfg, argv[0])

        parsed = parse_forward_args(argv)
        model_entry = resolve_model(cfg, parsed)
        check_port_free(parsed["host"], parsed["port"])

        port_lock_fd = acquire_port_lock(cfg["runtime_state_dir"], parsed["port"])
        try:
            return _run_engine(cfg, parsed, model_entry)
        finally:
            _release_lock(port_lock_fd)
    except WrapperError as exc:
        sys.stderr.write(f"{PROG}: refusing to start: {exc}\n")
        return 2
    finally:
        _release_lock(global_lock_fd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except WrapperError as exc:
        sys.stderr.write(f"{PROG}: refusing to start: {exc}\n")
        sys.exit(2)
